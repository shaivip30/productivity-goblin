{
  "manifest_version": 3,
  "name": "Productivity Goblin",
  "version": "1.0",
  "description": "A sarcastic goblin that judges your browsing habits.",
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }
],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Productivity Goblin"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}